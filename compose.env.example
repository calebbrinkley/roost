# Keep the configured copy outside the checkout.
ROOST_PUBLIC_ORIGIN=https://roost.example.com
ROOST_STATE_PATH=/REPLACE_PRIVATE_DIRECTORY/state
# This file may be empty for a model server that needs no API key.
ROOST_MODEL_KEY_SOURCE=/REPLACE_PRIVATE_DIRECTORY/model-key
# Optional installer prefill. Settings is the usual configuration path.
ROOST_MODEL_URL=https://models.example.com/v1
# Use id -u and id -g for the owner of the private files.
ROOST_UID=1000
ROOST_GID=1000
ROOST_PORT=8787
# Optional public HTTPS or mailto VAPID subject for push.
# ROOST_PUSH_SUBJECT=https://push.example.com
# Only enable when a trusted proxy is the sole route into the container.
ROOST_TRUST_FORWARDED=0
# Number of model requests Roost runs at once; extra requests wait their turn.
# ROOST_ADMISSION=1
