# Copy outside the checkout, replace placeholders, and keep this file private.
ROOST_PUBLIC_ORIGIN=https://REPLACE_PRIVATE_ROOST_HOST
# Optional: VAPID subject for push, e.g. https://REPLACE_PUBLIC_HOST or mailto:REPLACE_ADDRESS (Apple's push service rejects private host names).
# ROOST_PUSH_SUBJECT=https://REPLACE_PUBLIC_HOST
ROOST_HERMES_URL=https://REPLACE_HERMES_DASHBOARD_HOST:8445
ROOST_HERMES_USERNAME=REPLACE_OPERATOR_USERNAME
ROOST_HERMES_PASSWORD_SOURCE=/REPLACE_PRIVATE_DIRECTORY/hermes-password
ROOST_STATE_PATH=/REPLACE_PRIVATE_DIRECTORY/state
# Use the output of id -u and id -g for the owner of both private paths above.
ROOST_UID=1000
ROOST_GID=1000
# Optional host loopback port (container port stays 8787).
ROOST_PORT=8787
